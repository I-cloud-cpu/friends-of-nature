# Gmail API Configuration
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=token.pickle
GMAIL_USER_EMAIL=your-friends-of-nature-email@gmail.com

# Anthropic API Configuration
ANTHROPIC_API_KEY=sk-ant-v7-YOUR-ANTHROPIC-API-KEY-HERE

# Email Settings
EMAIL_FROM_NAME=Friends of Nature
EMAIL_SUBJECT_PREFIX=[Friends of Nature]
BATCH_SIZE=10
DELAY_BETWEEN_SENDS=2

# Web Scraping Settings
REQUEST_TIMEOUT=10
MAX_RETRIES=3
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36

# Logging
LOG_LEVEL=INFO
LOG_FILE_EXTRACTION=logs/extraction.log
LOG_FILE_EMAIL=logs/email_delivery.log
